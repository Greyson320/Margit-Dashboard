# ---------------------------------------------------------------------------
# Copy to .env for docker compose, or to backend/.env when running npm locally.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Auth — generate a real secret for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grantsdb

# File storage: "s3" (MinIO in dev, AWS S3 in production) or "local" (disk)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
# Signed URLs are rewritten to this host so the browser can reach the bucket.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grant-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./uploads

# Uploads
MAX_UPLOAD_MB=20
SIGNED_URL_TTL_SECONDS=300

# Notifications — "console" prints e-mails to the log, "none" stores them only
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@grant-portal.local

# Frontend (leave empty to use the Vite dev proxy at /api)
VITE_API_BASE_URL=
